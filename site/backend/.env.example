# GitHub App settings
GITHUB_APP_ID=123456
GITHUB_APP_NAME=RoleBit

# Prefer file-based key loading. Keep this file outside git tracking.
GITHUB_PRIVATE_KEY_FILE=C:/secure/rolebit/private-key.pem

# Optional fallback if not using GITHUB_PRIVATE_KEY_FILE:
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

GITHUB_WEBHOOK_SECRET=replace-with-strong-secret
GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret

# Frontend base URL for callback redirect after installation
APP_BASE_URL=http://localhost:5500

# Comma-separated usernames with admin privileges in RoleBit
ADMIN_USERNAMES=your_admin_username

# Optional CORS and rate limiting
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500
# RATE_LIMIT_MAX=600
# AUTH_RATE_LIMIT_MAX=25
